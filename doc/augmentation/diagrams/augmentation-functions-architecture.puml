@startuml

/' EVENTS '/
interface "WldtEvent" as we
interface "TriggeringEvent" as t {
    + AugmentationFunctionFilter target()
}
t ..|> we
interface "AugmentationEvent<T>" as Eaug {
    + T body()
}
Eaug ..|> t
interface "PhysicalEvent" as ept
ept ..|> we
interface "DigitalEvent" as edt
edt ..|> we

/' AUGMENTATION FUNCTIONS MODEL '/
interface "AugmentationFunction<T>" as aug {
    + T execute()
}

/' EXECUTION  '/
interface "ExecutionContext" as ec
interface "AugmentationFunctionExecutor" as EXaug {
    + setExecutionContext(ExecutionContext ec)
    + AugmentationEvent executeAugmentationFunction(AugmentationFunction<T> aug)
}

/' UTIL '/
interface "WldtEventListener" as wel {
    + onEvent(WldtEvent we)
}
interface "ShadowingFunction" as shad
shad ..|> wel
interface "EventBus" as ebus {
    + subscribe(EventFilter ef)
    + publish(WldtEvent we)
}

interface "SyncInterface" as si {
    + publishAugmentationEventToRemoteBus(AugmentationEvent ae)
    + receiveAugmentationEventFromRemoteBus(AugmentationEvent ae)
}
si ..|> wel

/' RELATIONSHIPS '/
EXaug -- ec
shad -- aug
shad -- EXaug
EXaug -> Eaug
ebus -- we
wel -- ebus

/' NOTES '/
note "Listens for remote Eaug and can publish to the remote bus Eaugs.\nModeled similarly to PI and DI." as n1
n1 .. si
@enduml
